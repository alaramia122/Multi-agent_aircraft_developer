# Copy this file to the repository root as .env.
# Generate a password with: openssl rand -hex 32

POSTGRES_DB=engineering_gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD

GATEWAY_PORT=8000
LOG_LEVEL=INFO

# The initial staging endpoint is deliberately read-only and reachable only
# through an SSH tunnel to localhost.
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
MCP_ALLOWED_ORIGINS=
MCP_ACTOR_ID=staging-readonly-agent
