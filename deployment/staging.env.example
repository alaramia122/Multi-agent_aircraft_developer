# Copy this file to the repository root as .env.
# Generate a password with: openssl rand -hex 32

POSTGRES_DB=engineering_gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD

GATEWAY_PORT=8000
LOG_LEVEL=INFO

# The initial staging endpoint is deliberately read-only and reachable only
# through an SSH tunnel to localhost.
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
MCP_ALLOWED_ORIGINS=
MCP_ACTOR_ID=staging-readonly-agent

# OpenProject is reached over its private Docker frontend network. Never commit
# a real API token. The IDs below match the manually provisioned staging objects.
OPENPROJECT_NETWORK=openproject_frontend
OPENPROJECT_BASE_URL=http://web:8080
OPENPROJECT_API_TOKEN=REPLACE_WITH_OPENPROJECT_SERVICE_TOKEN
OPENPROJECT_PROJECT_ID=3
OPENPROJECT_CHANGE_REQUEST_TYPE_ID=8
