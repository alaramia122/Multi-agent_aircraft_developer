# Gateway process
GATEWAY__HOST=0.0.0.0
GATEWAY__PORT=8000
GATEWAY__ENVIRONMENT=development
GATEWAY__VERSION=0.2.0
GATEWAY__LOG_LEVEL=INFO

# PostgreSQL
DATABASE__URL=postgresql+psycopg://gateway:gateway@localhost:5432/engineering_gateway
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10
DATABASE__POOL_TIMEOUT_SECONDS=30
DATABASE__POOL_RECYCLE_SECONDS=1800

# MCP
MCP__PATH=/mcp
MCP__ALLOWED_HOSTS=["localhost","localhost:*"]
MCP__ALLOWED_ORIGINS=[]
MCP__STATIC_ACTOR_ID=gateway-service
MCP__STATIC_ACTOR_TYPE=AI
MCP__STATIC_AUTHORIZATION_LEVEL=L0_READ

# Identity provider. Keep disabled until a production principal-to-Actor mapper is deployed.
IDENTITY__ENABLED=false
# IDENTITY__ISSUER_URL=https://identity.example.invalid/
# IDENTITY__AUDIENCE=engineering-gateway
# IDENTITY__READINESS_URL=https://identity.example.invalid/health/ready
IDENTITY__ACTOR_ID_CLAIM=sub
IDENTITY__ACTOR_TYPE_CLAIM=actor_type
IDENTITY__AUTHORIZATION_LEVEL_CLAIM=authorization_level
IDENTITY__PRINCIPAL_CLAIMS_STATE_KEY=trusted_principal_claims
# For a network-isolated reverse proxy that authenticates the public OIDC token.
IDENTITY__TRUSTED_PROXY_HEADERS_ENABLED=false
# IDENTITY__TRUSTED_PROXY_SHARED_SECRET=replace-with-at-least-32-random-bytes
IDENTITY__TRUSTED_PROXY_SECRET_HEADER=x-gateway-proxy-secret
IDENTITY__TRUSTED_PROXY_ACTOR_ID_HEADER=x-gateway-actor-id
IDENTITY__TRUSTED_PROXY_ACTOR_TYPE_HEADER=x-gateway-actor-type
IDENTITY__TRUSTED_PROXY_AUTHORIZATION_LEVEL_HEADER=x-gateway-authorization-level

# Git
GIT__ENABLED=true
GIT__REPOSITORY_ROOT=.
GIT__TIMEOUT_SECONDS=30

# StrictDoc
STRICTDOC__ENABLED=false
STRICTDOC__EXECUTABLE=strictdoc
# STRICTDOC__PROJECT_PATH=/srv/strictdoc/project
STRICTDOC__TIMEOUT_SECONDS=60
STRICTDOC__WORKSPACE_MUTATIONS_ENABLED=false
# STRICTDOC__WORKSPACE_BRIDGE_EXECUTABLE=/srv/strictdoc-bridge/strictdoc-bridge

# Capella headless bridge
CAPELLA__ENABLED=false
# CAPELLA__EXECUTABLE=/opt/capella/bin/capella-bridge
# CAPELLA__PROJECT_PATH=/srv/capella/project.aird
CAPELLA__TIMEOUT_SECONDS=120

# OpenProject API v3
OPENPROJECT__ENABLED=false
# OPENPROJECT__BASE_URL=https://openproject.example.invalid
# OPENPROJECT__API_TOKEN=replace-me
# OPENPROJECT__PROJECT_ID=1
# OPENPROJECT__CHANGE_REQUEST_TYPE_ID=1
OPENPROJECT__TIMEOUT_SECONDS=30

# S3-compatible object storage for large artifacts
OBJECT_STORAGE__ENABLED=false
# OBJECT_STORAGE__ENDPOINT_URL=https://storage.example.invalid
# OBJECT_STORAGE__BUCKET=engineering-artifacts
OBJECT_STORAGE__REGION=us-east-1
# OBJECT_STORAGE__ACCESS_KEY_ID=replace-me
# OBJECT_STORAGE__SECRET_ACCESS_KEY=replace-me
OBJECT_STORAGE__CONNECT_TIMEOUT_SECONDS=10
