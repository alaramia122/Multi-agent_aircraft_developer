# Public DNS A records pointing to the VM.
GATEWAY_DOMAIN=gateway-staging.example.com
IDP_DOMAIN=id-staging.example.com
OPENPROJECT_DOMAIN=openproject-staging.example.com
ACME_EMAIL=ops@example.com

# Pin these after the first successful staging qualification.
KEYCLOAK_VERSION=26.0
OAUTH2_PROXY_VERSION=v7.7.1
OPENPROJECT_VERSION=16-slim
CADDY_VERSION=2.10-alpine
STRICTDOC_PACKAGE=strictdoc

# Generate unique values; never commit the populated .env file.
PLATFORM_POSTGRES_PASSWORD=replace-with-random-postgres-password
KEYCLOAK_ADMIN=staging-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-keycloak-password
OAUTH2_PROXY_CLIENT_ID=engineering-gateway
OAUTH2_PROXY_CLIENT_SECRET=replace-after-creating-keycloak-client
OAUTH2_PROXY_COOKIE_SECRET=replace-with-base64-encoded-32-byte-secret
TRUSTED_PROXY_SHARED_SECRET=replace-with-at-least-32-random-bytes
OPENPROJECT_SECRET_KEY_BASE=replace-with-at-least-64-random-bytes

# The MCP surface is an AI-only L2 boundary; L3 remains human-only and outside MCP.
GATEWAY_MCP_ACTOR_TYPE=ai
GATEWAY_MCP_AUTHORIZATION_LEVEL=L2_MODIFY_WORKSPACE

# Enable each real integration only after its data and credentials are installed.
STRICTDOC_ENABLED=false
STRICTDOC_PROJECT_DIR=./data/strictdoc
STRICTDOC_WORKSPACE_MUTATIONS_ENABLED=false
STRICTDOC_BRIDGE_DIR=./data/strictdoc-bridge
CAPELLA_ENABLED=false
CAPELLA_PROJECT_DIR=./data/capella
CAPELLA_BRIDGE_DIR=./data/capella-bridge
OPENPROJECT_ENABLED=false
OPENPROJECT_API_TOKEN=replace-after-openproject-bootstrap
OPENPROJECT_PROJECT_ID=1
OPENPROJECT_CHANGE_REQUEST_TYPE_ID=1
